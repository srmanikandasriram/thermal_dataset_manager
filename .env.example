THERMAL_DATA_ROOT=./datasets
# THERMAL_CATALOG_DB is optional -- if unset, it defaults to
# <THERMAL_DATA_ROOT>/catalog.sqlite, so the catalog can never silently end
# up pointing somewhere else than the data it's supposed to index just
# because the server was started from a different working directory. Only
# set this explicitly if you want the catalog DB stored somewhere other
# than inside THERMAL_DATA_ROOT (e.g. a real Postgres URL later).
# THERMAL_CATALOG_DB=sqlite:///./datasets/catalog.sqlite
THERMAL_CORS_ORIGINS=http://localhost:5173
